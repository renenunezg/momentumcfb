# CollegeFootballData API key.
CFBD_API_KEY=

# The Odds API key and optional market filters. With both filters empty the
# client queries its built-in list of ten books, which includes Pinnacle.
ODDS_API_KEY=
ODDS_API_BOOKMAKERS=
ODDS_API_REGIONS=

# Supabase Postgres connection string.
# Model and test commands do not need this unless they read or publish serving data.
DATABASE_URL=

# Never set this for read-only work.
# Publishing workflows set it only on database mutation steps.
MOMENTUMCFB_DB_WRITES=0
